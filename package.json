{
  "name": "hoechem-sacco",
  "private": true,
  "version": "1.0.0",
  "description": "HOECHEM SACCO Digital Platform — Monorepo",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "turbo run type-check",
    "db:generate": "pnpm --filter @hoechem/api db:generate",
    "db:migrate": "pnpm --filter @hoechem/api db:migrate",
    "db:seed": "pnpm --filter @hoechem/api db:seed",
    "db:push": "pnpm --filter @hoechem/api db:push"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.24.0"
    }
  }
}
