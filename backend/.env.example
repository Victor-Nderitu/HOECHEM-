# =============================================================================
# HOECHEM SACCO – Backend Environment Variables (TEMPLATE)
# Copy this file to .env and fill in your values.
# =============================================================================

# Supabase PostgreSQL connection (Transaction/Pooling mode - for app runtime)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true&connection_limit=1"

# Supabase PostgreSQL direct connection (for Prisma migrations)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# JWT signing secret — use a random 32+ char string in production
JWT_SECRET="change-this-to-a-strong-random-secret"

# App server port
PORT=3001

# Frontend origin for CORS
FRONTEND_URL="http://localhost:3000"

# Supabase project credentials (for file storage)
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_KEY="[SUPABASE-ANON-KEY]"
